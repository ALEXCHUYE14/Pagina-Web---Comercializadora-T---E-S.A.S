# =====================================================================
# Comercializadora T&E S.A.S. — Variables de entorno
# Copia este archivo a ".env" y rellena los valores reales.
# Obtén las claves en: Supabase Dashboard -> Project Settings -> API
# =====================================================================

# URL del proyecto Supabase (ej: https://xxxxx.supabase.co)
SUPABASE_URL=

# Clave pública "anon" (segura para el frontend, protegida por RLS)
SUPABASE_ANON_KEY=

# Número de WhatsApp Business en formato internacional sin "+" (ej: 573001112233)
WHATSAPP_NUMBER=570000000000
